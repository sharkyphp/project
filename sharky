declare (strict_types = 1);

use Sharky\Foundation\Kernel\ConsoleKernel;

define('SHARKY_START', microtime(true));

// 启动框架
$app = require_once __DIR__ . "/bootstrap.php";
$app->bootstrap();

// 启动Console核心
$kernel = ConsoleKernel::launch();

// 处理Console命令
$kernel->handleConsole($argv);

// 执行终止程序
$kernel->terminate();
